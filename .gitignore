# pid-to-kg working directories: keep the extraction files and the built graph,
# ignore regenerable renders, tiles, crops and hints
work/*/*
!work/*/extract/
!work/*/kg/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Source drawings (often confidential; not committed by default)
input/

# BTM gas engine client projects (client data; commit only on purpose with git add -f)
projects/
